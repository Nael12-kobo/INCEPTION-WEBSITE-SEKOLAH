# =============================================================
# Template environment — salin ke .env lalu isi nilainya:
#   cp .env.example .env
# =============================================================

# ---------- Wajib: Database (PostgreSQL / Supabase) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Dipakai Prisma untuk perintah migrate/db push (koneksi "pintas")
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------- Wajib: Auth (Auth.js / NextAuth v5) ----------
# Buat secret: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------- Opsional: Login OAuth ----------
# Tanpa ini, login Credentials (email + kata sandi) tetap berfungsi.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------- Opsional: Chat AI (Google Gemini) ----------
# Tanpa ini halaman tetap jalan, hanya chat AI yang memberi pesan error.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Cadangan kalau key utama kena rate limit / error:
GEMINI_FALLBACK_API_KEY=""
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# ---------- Opsional: Suara karakter (TTS via Fish Audio) ----------
FISH_AUDIO_API_KEY=""
FISH_AUDIO_MODEL=""
FISH_AUDIO_REFERENCE_ID=""

# ---------- Opsional: Email otomatis (Resend) ----------
# Untuk email reset password & notifikasi PPDB. Tanpa ini email tidak terkirim.
RESEND_API_KEY=""
RESEND_FROM=""

# ---------- Opsional: Notifikasi WhatsApp Cloud API (PPDB) ----------
WHATSAPP_PHONE_ID=""
WHATSAPP_TOKEN=""
# Nomor panitia (format 62xxx). Bila kosong memakai default bawaan kode.
PPDB_WA_NUMBER=""

# ---------- Opsional: Situs ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Karakter 3D di chat. Default: /models/character.vrm dan versi "3".
NEXT_PUBLIC_VRM_URL=""
NEXT_PUBLIC_VRM_VERSION=""
