# ============================================================
# Template environment — salin ke .env lalu isi nilainya
#   cp .env.example .env
# ============================================================

# ===== Database (PostgreSQL / Supabase) — WAJIB =====
# Pooler (port 6543) untuk aplikasi:
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"
# Direct (port 5432) untuk Prisma CLI (db push / migrate):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ===== Auth.js (NextAuth v5) — WAJIB =====
# Rahasia sesi — buat dengan: openssl rand -base64 32
AUTH_SECRET=""
# Base URL aplikasi (tanpa slash di akhir)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Wajib true saat deploy di belakang proxy / production self-hosted
AUTH_TRUST_HOST=true

# ===== Google OAuth — untuk login "Lanjutkan dengan Google" =====
# Dari Google Cloud Console → Credentials → OAuth client ID
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== GitHub OAuth — OPSIONAL (kosongkan untuk menonaktifkan) =====
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===== Email reset password (Resend) — OPSIONAL =====
RESEND_API_KEY=""
RESEND_FROM="SMK Tunas Harapan <no-reply@example.com>"

# ===== WhatsApp PPDB — OPSIONAL =====
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
PPDB_WA_NUMBER="628xxxxx" # Nomor WhatsApp PPDB (untuk kirim notifikasi ke calon siswa)

# ===== Chatbot AI (Google Gemini) — WAJIB untuk chatbot =====
# Ambil API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Model (opsional). Default: gemini-3.5-flash-lite
GEMINI_MODEL="gemini-3.5-flash-lite"