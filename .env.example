NEXT_PUBLIC_SUPABASE_URL=https://lspqcbigavymgxajbpfk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9iAARAujupkXOZsqXwg7Pw_UXQ1Mg0w
# ===== Database (PostgreSQL / Supabase) — WAJIB =====
# Isi dengan kredensial milikmu sendiri — JANGAN pernah commit nilai aslinya.
#   Supabase Dashboard → Project Settings → Database → Connection string
# Pooler (port 6543) untuk aplikasi:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# ===== Auth.js (NextAuth v5) — WAJIB =====
# Rahasia sesi — buat dengan: openssl rand -base64 32
AUTH_SECRET=""
# Base URL aplikasi (tanpa slash di akhir)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Wajib true saat deploy di belakang proxy / production self-hosted
AUTH_TRUST_HOST=true

# ===== Google OAuth — untuk login "Lanjutkan dengan Google" =====
# Dari Google Cloud Console → Credentials → OAuth client ID
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== GitHub OAuth — OPSIONAL (kosongkan untuk menonaktifkan) =====
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ===== Email reset password (Resend) — OPSIONAL =====
RESEND_API_KEY=""
RESEND_FROM="SMK Tunas Harapan <no-reply@example.com>"

# ===== WhatsApp PPDB — OPSIONAL =====
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
PPDB_WA_NUMBER="628xxxxx" # Nomor WhatsApp PPDB (untuk kirim notifikasi ke calon siswa)

# ===== Gemini AI (chat asisten) — WAJIB untuk /chat =====
# Ambil API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# ===== Voice AI (Fish Audio) — opsional, aktifkan suara NARA =====
# API key: https://fish.audio/
FISH_AUDIO_API_KEY=""
# Model gratis untuk prototype/development.
FISH_AUDIO_MODEL="s2.1-pro-free"
# Isi dengan reference_id voice Fish Audio milik NARA untuk voice cloning.
# Kosongkan untuk memakai voice default/model.
FISH_AUDIO_REFERENCE_ID=""
