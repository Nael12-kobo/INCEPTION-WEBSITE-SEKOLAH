// Skema database (PostgreSQL) untuk auth.
// Model User/Account/Session/VerificationToken mengikuti kontrak
// @auth/prisma-adapter (Auth.js / NextAuth v5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt hash — hanya terisi untuk akun credentials
  role          UserRole @default(USER)
  createdAt     DateTime  @default(now())
  /// Foto siswa (syarat PPDB). Disimpan langsung di DB (bytea) agar tidak
  /// butuh storage eksternal — dibaca/diunduh lewat API yang butuh login.
  photoBytes     Bytes?
  photoMime      String?
  photoUpdatedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  ppdbRegistration PpdbRegistration?
  auditLogs     AuditLog[]
  chatConversations ChatConversation[]
  chatFeedbacks ChatFeedback[]
  ppdbDocuments PpdbDocument[]
  ppdbDocumentReviews PpdbDocumentReview[]
  academicGrades AcademicGrade[]
  academicAttendance AcademicAttendance[]
  academicExamCards AcademicExamCard[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Audit trail: setiap aksi penting (login, ubah role, ubah status PPDB,
// dsb) dicatat di sini oleh helper `logAudit` di src/lib/audit.ts.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null = aksi anonim (mis. login gagal)
  actorEmail String? // snapshot email agar tetap terbaca bila akun dihapus
  action     String // kode aksi, mis. USER_LOGIN, USER_ROLE_CHANGE
  targetType String? // jenis objek yang disentuh: USER, PPDB, AUTH
  targetId   String?
  detail     String? // keterangan singkat manusiawi
  meta       Json? // data tambahan terstruktur (old/new, provider, dsb)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

// Histori chat AI. Satu baris = satu conversation milik user login;
// messages disimpan sebagai JSON [{role, content, createdAt}].
// Akun guest tidak disimpan (hanya localStorage di client).
model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Percakapan baru")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

// Feedback per jawaban AI (👍/👎). Bisa dari user login maupun guest
// (userId null) — dipakai halaman /admin/chat untuk menilai kualitas
// jawaban dan menemukan topik knowledge yang perlu diperbaiki.
model ChatFeedback {
  id             String     @id @default(cuid())
  userId         String?
  conversationId String? // null untuk guest (tidak ada baris chat_conversations)
  /// ID pesan di ChatMessage client (uid lokal) — untuk cek "sudah vote?".
  messageId      String
  /// Snapshot pertanyaan user sebelum jawaban ini (maks 500 char).
  question       String
  /// Snapshot jawaban AI (maks 2000 char) — bahan evaluasi bila isi konten
  /// knowledge berubah nanti.
  answer         String
  rating         ChatRating
  /// Alasan singkat (opsional, diisi user saat memberi rating).
  comment        String? // maks 500 char
  /// IP client (untuk rate-limit & deteksi spam guest).
  ip             String?
  createdAt      DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([messageId, ip])
  @@index([createdAt])
  @@index([rating])
  @@map("chat_feedbacks")
}

enum ChatRating {
  UP
  DOWN
}

// Cache jawaban AI per pertanyaan ternormalisasi. Pertanyaan populer
// ("Berapa biaya PPDB?") diulang ratusan kali — hit cache = nol panggilan
// Gemini (hemat kuota GEMINI_API_KEY). TTL dijaga aplikasi via expiresAt.
model ChatQACache {
  id        String   @id @default(cuid())
  /// Pertanyaan ternormalisasi (huruf kecil, spasi dirapikan, maks 300 char).
  key       String   @unique
  reply     String
  /// File knowledge yang dipakai saat jawaban dibuat (chip "Sumber").
  sources   Json     @default("[]")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("chat_qa_cache")
}

// Pertanyaan yang TIDAK ketemu keyword knowledge (retrieval nol kecocokan).
// Di-agregasi per pertanyaan ternormalisasi — ditampilkan admin di
// /admin/chat sebagai bahan mengisi knowledge/*.md / menambah keyword baru.
model ChatMissLog {
  id        String   @id @default(cuid())
  /// Pertanyaan user ternormalisasi (maks 300 char).
  question  String   @unique
  /// Berapa kali pertanyaan ini tercatat sebagai miss.
  count     Int      @default(1)
  lastAt    DateTime @default(now())

  @@index([count])
  @@map("chat_miss_logs")
}

// Pendaftaran PPDB 2026/2027. Satu akun (User) boleh mendaftar satu kali;
// nomor pendaftaran dibuat server dan dipakai sebagai rujukan di WhatsApp.

enum PpdbStatus {
  PENDING
  CONTACTED
  APPROVED
  REGISTERED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model PpdbRegistration {
  id            String  @id @default(cuid())
  registrationNo String @unique
  userId        String @unique
  fullName      String
  email         String
  gender        String
  birthPlace    String
  birthDate     DateTime
  previousSchool String
  address       String
  phone         String
  majorFirst    String
  majorSecond   String
  parentName    String
  parentPhone   String
  notes         String?
  /// Teks pengumuman dari admin saat ACC (tampil di dashboard siswa status APPROVED).
  announcement  String?
  status        PpdbStatus @default(PENDING)
  waSentAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("ppdb_registrations")
}

// Berkas kelengkapan syarat PPDB (bukti pembayaran, fotokopi rapor, akte,
// kartu keluarga) yang diunggah siswa dari dashboard setelah formulir terisi.
// Satu jenis berkas boleh berisi beberapa file (mis. rapor per semester).
// Pas foto tidak di sini — disimpan di kolom User.photoBytes karena wajib
// sejak pengisian formulir.
model PpdbDocument {
  id        String   @id @default(cuid())
  userId    String
  /// Jenis berkas: PEMBAYARAN | RAPOR | AKTE | KK (lihat src/lib/ppdb-documents.ts).
  kind      String
  /// Nama file asli dari perangkat siswa (untuk ditampilkan di panel admin).
  fileName  String
  mime      String
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("ppdb_documents")
}

// Penilaian admin per item kelengkapan berkas PPDB (4 dokumen + pas foto).
// Satu baris per (siswa, jenis item); status: SESUAI | PERLU_PERBAIKAN.
// Dihapus otomatis oleh endpoint siswa saat berkas/ foto terkait diganti
// atau dihapus, supaya penilaian lama tidak menempel pada berkas baru.
model PpdbDocumentReview {
  id         String   @id @default(cuid())
  userId     String
  /// Jenis item: PEMBAYARAN | RAPOR | AKTE | KK | FOTO (lihat src/lib/ppdb-documents.ts).
  kind       String
  /// Status penilaian: SESUAI | PERLU_PERBAIKAN.
  status     String
  /// Catatan admin untuk siswa (mis. "foto kurang jelas, mohon diganti").
  note       String?
  /// Email admin yang menilai — jejak singkat untuk siswa/admin lain.
  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("ppdb_document_reviews")
}

// ===== Data akademik siswa (Bagian C) =====================================
// Diisi admin lewat Admin Panel > Akademik, dibaca portal siswa /student/*.
// Tanggal & jam memakai string ("YYYY-MM-DD", "HH:mm", "YYYY-MM-DDTHH:mm")
// agar bebas masalah zona waktu dan cocok langsung dengan input form.

/// Jadwal pelajaran/piket — berlaku per jurusan atau semua (major null).
model AcademicSchedule {
  id        String   @id @default(cuid())
  day       String // "Senin" .. "Sabtu"
  startTime String // "07:30"
  endTime   String // "09:00"
  subject   String
  teacher   String?
  major     String? // JurusanValue; null = semua jurusan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@map("academic_schedules")
}

/// Nilai per siswa.
model AcademicGrade {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  kind      String // "Tugas" | "UTS" | "UAS" | "Praktik" | "Rapor"
  score     Float
  semester  String? // bebas: "Ganjil 2026/2027"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("academic_grades")
}

/// Absensi harian per siswa — `date` = "YYYY-MM-DD".
model AcademicAttendance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  status    String // "HADIR" | "IZIN" | "SAKIT" | "ALFA"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("academic_attendance")
}

/// Tugas dari guru — tampil ke semua siswa atau per jurusan.
model AcademicTask {
  id          String   @id @default(cuid())
  title       String
  subject     String
  description String?
  dueAt       String? // "YYYY-MM-DD" atau "YYYY-MM-DDTHH:mm"
  major       String? // null = semua jurusan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dueAt])
  @@map("academic_tasks")
}

// ===== Konten situs publik (Bagian D) =====================================
// Diisi admin lewat Admin Panel > Program Keahlian / Berita, dibaca halaman
// publik /jurusan, homepage, dan /berita/[slug].

/// Program keahlian.
///
/// Empat jurusan bawaan (PPLG, TJKT, DKV, TKRO) disimpan di sini dengan
/// flag `bawaan = true` supaya bisa diedit dari Admin Panel. Halaman detail
/// mereka tetap memakai route statis (`src/app/jurusan/<KODE>/page.tsx`) agar
/// dekorasi hero khusus tetap dipakai, tetapi kontennya dibaca dari baris DB
/// (fallback ke konstanta bila belum tersedia). Jurusan BARU memakai kode
/// huruf kecil dan dirender `src/app/jurusan/[kode]/page.tsx`.
model Jurusan {
  id        String   @id @default(cuid())
  /// Slug URL (huruf kecil/angka/dash), mis. "ul" — unik, case-sensitive.
  kode      String   @unique
  /// Nama lengkap program keahlian.
  nama      String
  /// Singkatan/ kode kelas, mis. "UL".
  singkatan String
  /// Subjudul hero halaman detail (opsional).
  tagline   String?
  /// Ringkasan singkat untuk kartu homepage & daftar /jurusan.
  deskripsi String
  /// Narasi "Tentang <jurusan>" — paragraf dipisahkan baris kosong.
  tentang   String   @default("")
  /// Chip keterampilan di kartu homepage, mis. ["Web", "Database"].
  skills    String[] @default([])
  /// Daftar poin keunggulan jurusan.
  keunggulan String[] @default([])
  /// Materi yang dipelajari: [{ "judul": string, "deskripsi": string }].
  kompetensi Json     @default("[]")
  /// Prospek karir: [{ "pekerjaan": string, "gaji": string }].
  karir     Json     @default("[]")
  /// Kunci ikon lucide — daftarnya di IKON_JURUSAN (src/lib/jurusan.ts).
  ikon      String   @default("GraduationCap")
  /// Kunci tema warna — daftarnya di WARNA_JURUSAN (src/lib/jurusan.ts).
  warna     String   @default("sky")
  /// URL gambar hero halaman detail (opsional; gambar eksternal ditampilkan
  /// tanpa optimizer Next supaya bebas domain). Boleh juga path lokal
  /// yang diawali "/" (mis. "/jurusan/PPLG.png") untuk jurusan bawaan.
  gambar    String?
  /// Paragraf intro tambahan di hero halaman detail (opsional).
  heroTeks  String?
  /// Subjudul seksi "Kompetensi" & "Prospek Karir" di halaman detail
  /// (opsional; kosong = memakai teks generik template).
  introKompetensi String @default("")
  introKarir      String @default("")
  /// Judul & teks tombol CTA di bagian bawah halaman detail (opsional).
  ctaJudul        String @default("")
  ctaTeks         String @default("")
  /// true = salah satu dari 4 jurusan bawaan (PPLG/TJKT/DKV/TKRO) dengan
  /// route khusus. Diset oleh inisialisasi server, bukan form admin.
  bawaan    Boolean  @default(false)
  /// Urutan tampil (makin kecil makin awal); bawaan memakai 10, 20, 30, 40.
  urutan    Int      @default(100)
  /// false = disembunyikan dari situs tanpa perlu menghapus data.
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif, urutan])
  @@map("jurusans")
}

/// Konten halaman publik (CMS ringan) — satu baris per bagian halaman.
/// Kolom `content` berbentuk Json; skemanya didefinisikan & divalidasi di
/// `src/lib/site-content.ts` (hero, statistik, profil, fasilitas, ppdb-cta,
/// guru). Selama baris belum ada / belum divalidasi, situs memakai nilai
/// default dari kode sehingga halaman tidak pernah kosong.
model SiteContent {
  key       String   @id
  content   Json
  /// Id user admin terakhir yang menyimpan (untuk jejak audit).
  updatedBy String?
  updatedAt DateTime @updatedAt
  @@map("site_contents")
}

/// Berita buatan admin (tambahan di samping berita otomatis dari WordPress).
/// Berita web tetap ditarik `src/lib/blog.ts` dan tidak disimpan di DB.
model Berita {
  id        String   @id @default(cuid())
  /// Slug URL unik untuk halaman detail /berita/[slug].
  slug      String   @unique
  judul     String
  /// Ringkasan untuk kartu berita (±180 karakter).
  ringkasan String
  /// Isi artikel — paragraf dipisahkan baris kosong. Boleh kosong.
  konten    String?
  kategori  String   @default("Berita")
  /// Tanggal tampil sekaligus kunci urutan (terbaru di atas).
  tanggal   DateTime @default(now())
  /// URL gambar sampul (opsional).
  gambar    String?
  /// Tautan keluar, mis. ke pengumuman resmi. Kosong = kartu mengarah ke
  /// /berita/[slug].
  url       String?
  /// URL artikel sumber (mis. WordPress). Jika diisi, artikel lokal ini
  /// menjadi salinan yang dapat disunting dan menggantikan kartu sumbernya.
  sourceUrl String?  @unique
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, tanggal])
  @@map("beritas")
}

/// Kartu ujian per siswa.
model AcademicExamCard {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examName      String // "UTS" | "UAS" | "US" | bebas
  startDate     String // "YYYY-MM-DD"
  endDate       String?
  room          String
  seatNo        String?
  participantNo String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("academic_exam_cards")
}
